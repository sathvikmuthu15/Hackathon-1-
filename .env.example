# Copy to .env and fill in locally. Never commit .env.
# Which AI backend to use: "gemini" or "anthropic"
AI_PROVIDER=gemini

# Google Gemini (only needed when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-key-here
# Current vision-capable model name from https://ai.google.dev/gemini-api/docs/models
# (as of Oct 2026 the docs recommend e.g. gemini-3.5-flash-lite for speed/cost, gemini-3.8-flash for quality)
GEMINI_MODEL=your-gemini-model-name

# Anthropic Claude (only needed when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-key-here
# Current vision-capable model name from https://platform.claude.com/docs/en/about-claude/models
# (as of Oct 2026: claude-opus-5-5 for best accuracy, claude-haiku-5-5 for speed/cost)
ANTHROPIC_MODEL=your-claude-model-name

# Backend proxy port
PORT=8787

# Max upload size for one image, in megabytes
MAX_IMAGE_MB=6
