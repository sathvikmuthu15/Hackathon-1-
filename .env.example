# Copy to .env and fill in locally. Never commit .env.
# Which AI backend to use: "gemini" or "anthropic"
AI_PROVIDER=gemini

# Google Gemini (only needed when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-key-here
# Use a current vision-capable model name from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=your-gemini-model-name

# Anthropic Claude (only needed when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-key-here
# Use a current vision-capable model name from https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=your-claude-model-name

# Backend proxy port
PORT=8787

# Max upload size for one image, in megabytes
MAX_IMAGE_MB=6
